#!/bin/bash
# Send files to Andy (omarchy) via Tailscale Taildrop.
# Installed by script/bootstrap-mac → ~/.local/bin/send-to-omarchy
# Finder Quick Action and CLI both call this.
# Lands in ~/Downloads on the Beelink.

set -euo pipefail

TS="${TAILSCALE:-/opt/homebrew/bin/tailscale}"
TARGET="${SEND_TO_OMARCHY_TARGET:-omarchy:}"

notify() {
	/usr/bin/osascript \
		-e 'on run argv' \
		-e 'display notification (item 2 of argv) with title (item 1 of argv)' \
		-e 'end run' \
		-- "$1" "$2" >/dev/null 2>&1 || true
}

die() {
	notify "Send to Omarchy" "$1"
	echo "send-to-omarchy: $1" >&2
	exit 1
}

if [[ $# -eq 0 ]]; then
	echo "Usage: send-to-omarchy <file> [file...]" >&2
	echo "Or right-click a file in Finder → Quick Actions → Send to Omarchy" >&2
	exit 1
fi

if [[ ! -x "$TS" ]]; then
	die "tailscale not found at $TS"
fi

tmpdir=
cleanup() {
	if [[ -n "${tmpdir:-}" && -d "$tmpdir" ]]; then
		rm -rf "$tmpdir"
	fi
}
trap cleanup EXIT

payloads=()
names=()
for arg in "$@"; do
	if [[ ! -e "$arg" ]]; then
		die "not found: $arg"
	fi
	if [[ -d "$arg" ]]; then
		if [[ -z "$tmpdir" ]]; then
			tmpdir=$(mktemp -d /tmp/send-to-omarchy.XXXXXX)
		fi
		name=$(basename "$arg")
		zipfile="$tmpdir/${name}.zip"
		/usr/bin/ditto -c -k --keepParent "$arg" "$zipfile" || die "failed to zip $name"
		payloads+=("$zipfile")
		names+=("${name}.zip")
	else
		payloads+=("$arg")
		names+=("$(basename "$arg")")
	fi
done

if ! "$TS" file cp --verbose "${payloads[@]}" "$TARGET"; then
	die "Taildrop failed — is Tailscale up and omarchy online?"
fi

count=${#names[@]}
if [[ $count -eq 1 ]]; then
	notify "Send to Omarchy" "Sent ${names[0]} → Andy ~/Downloads"
	echo "sent ${names[0]} → omarchy: (Andy ~/Downloads)"
else
	notify "Send to Omarchy" "Sent $count items → Andy ~/Downloads"
	echo "sent $count items → omarchy: (Andy ~/Downloads)"
fi
