#!/usr/bin/env bash
#
# Installs the machine-agnostic shell environment on a Mac (zsh) or on the
# Omarchy/Arch agent host (bash):
#   - shell/env.sh     (Homebrew, nvm, mise, uv, bun, opencode, completions)
#   - shell/aliases.sh (work, yolo)
#   - shell/foundry.sh (Claude Code Azure Foundry subscription switching)
#   - shell/motd.sh    (startup banner — commands + live context)
#   - terminal/herdr.toml -> ~/.config/herdr/config.toml (Herdr keybindings)
#
# Everything in shell/ is POSIX-compatible and sourced by BOTH zsh and bash;
# shell-specific bits sit behind $ZSH_VERSION / $BASH_VERSION guards. That is
# deliberate: the agent host runs Omarchy's stock bash, and switching its
# login shell to zsh would mean re-implementing Omarchy's own bash layer
# (envs/aliases/functions/inputrc) and re-testing it on every Omarchy update,
# for a machine that is driven through Moshi rather than typed at.
#
# Run this before bootstrap-mac. Safe to re-run — it appends guarded source
# lines and symlinks, never overwriting an existing file.
#
# Secrets (Foundry API keys, per-machine overrides) go in ~/.shell.local,
# which this script creates as a stub and which is never committed. The older
# ~/.zshrc.local is still sourced if present, so existing machines keep their
# keys without a manual move.

set -e
cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)
source script/lib.sh

# Pick the rc file for the login shell. $SHELL is the login shell, which is
# what matters here — not the shell running this script (bash, via shebang).
case "${SHELL##*/}" in
  zsh)  RCFILE="$HOME/.zshrc" ;;
  bash) RCFILE="$HOME/.bashrc" ;;
  *)
    if [ -n "$ZSH_VERSION" ]; then RCFILE="$HOME/.zshrc"; else RCFILE="$HOME/.bashrc"; fi
    info "unrecognised login shell '${SHELL##*/}' — defaulting to $RCFILE"
    ;;
esac
info "wiring $RCFILE (login shell: ${SHELL##*/})"

# Everything this script contributes lives in one managed block that is
# rewritten wholesale on each run. Appending line-by-line (the previous
# approach) could not guarantee ORDER — the local secrets file has to load
# before foundry.sh, and motd.sh after it — and it silently duplicated lines
# whenever a path was written differently ("$HOME/.zshrc.local" vs the
# expanded "/Users/matt/.zshrc.local" do not match a literal grep). Your own
# lines live outside the markers and are never touched.
BEGIN_MARK="# >>> dotfiles (script/bootstrap-shell) >>>"
END_MARK="# <<< dotfiles (script/bootstrap-shell) <<<"

touch "$RCFILE"
cp "$RCFILE" "$RCFILE.dotfiles.bak"

# Strip the previous managed block, plus any stray source lines from before
# managed blocks existed (including the pre-rename zsh/*.zsh layout).
awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
  $0 == b { skip = 1; next }
  $0 == e { skip = 0; next }
  skip { next }
  { print }
' "$RCFILE" \
  | grep -vF "$DOTFILES_ROOT/zsh/" \
  | grep -vF "$DOTFILES_ROOT/shell/" \
  | grep -vF '.zshrc.local' \
  | grep -vF '.shell.local' \
  > "$RCFILE.new"

# Collapse the trailing blank lines the strip may leave behind.
printf '%s\n' "$(cat "$RCFILE.new")" > "$RCFILE"
rm -f "$RCFILE.new"

{
  echo ""
  echo "$BEGIN_MARK"
  echo "# Regenerated by script/bootstrap-shell. Edits here are lost; put your"
  echo "# own settings outside this block, or in ~/.shell.local."
  echo "[ -f \"$DOTFILES_ROOT/shell/env.sh\" ] && . \"$DOTFILES_ROOT/shell/env.sh\""
  echo "[ -f \"$DOTFILES_ROOT/shell/aliases.sh\" ] && . \"$DOTFILES_ROOT/shell/aliases.sh\""
  echo "# Legacy local file, sourced first so machines bootstrapped before the"
  echo "# rename keep their existing keys."
  echo "[ -f \"\$HOME/.zshrc.local\" ] && . \"\$HOME/.zshrc.local\""
  echo "[ -f \"\$HOME/.shell.local\" ] && . \"\$HOME/.shell.local\""
  echo "# foundry.sh reads the keys above; motd.sh reads foundry's state."
  echo "[ -f \"$DOTFILES_ROOT/shell/foundry.sh\" ] && . \"$DOTFILES_ROOT/shell/foundry.sh\""
  echo "[ -f \"$DOTFILES_ROOT/shell/motd.sh\" ] && . \"$DOTFILES_ROOT/shell/motd.sh\""
  echo "$END_MARK"
} >> "$RCFILE"
success "wrote managed block to $RCFILE (backup: $RCFILE.dotfiles.bak)"

# The local secrets file must exist before foundry.sh looks for keys.
if [ ! -f "$HOME/.shell.local" ]; then
  cat > "$HOME/.shell.local" <<'EOF'
# Machine-specific settings and secrets. Never committed.
#
# export INCONTEXT_FOUNDRY_API_KEY=...
# export SITTADEL_FOUNDRY_API_KEY=...
#
# Override the agent host if this machine should target a different one:
# export ANDY_HOST=mini
EOF
  success "created ~/.shell.local stub"
else
  success "~/.shell.local already exists"
fi

# Herdr's config, if Herdr is installed here. link_file refuses to clobber a
# real file, so an existing hand-written config must be moved aside first.
if command -v herdr >/dev/null 2>&1; then
  link_file "$DOTFILES_ROOT/terminal/herdr.toml" "$HOME/.config/herdr/config.toml"
  if herdr server reload-config >/dev/null 2>&1; then
    success "reloaded the running Herdr server"
  else
    info "no running Herdr server to reload (config applies on next launch)"
  fi
else
  info "herdr not installed here — skipping config symlink"
fi

echo ""
echo "  Shell environment installed into $RCFILE."
echo "  Open a new tab or: source $RCFILE"
echo "  Put Foundry API keys in ~/.shell.local to enable use-*-foundry."
