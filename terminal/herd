#!/usr/bin/env python3
"""herd — drive the current Herdr session from inside an agent pane.

Thin, opinionated wrapper over the `herdr` CLI for the handful of moves an
agent actually makes: put a long command in a sibling pane, stand up a second
agent to review, raise a toast, and see the whole herd at a glance.

Two invariants this script exists to protect:

1. **Panes are created at $HOME, always.** Claude project memory is keyed off
   cwd — `~/.claude/projects/-home-matt/memory` is a symlink into the vault and
   is shared with Cursor. A pane started anywhere else writes under
   `-home-matt-<path>` and silently misses that store. Never pass a repo path
   as a pane cwd; operate on worktrees by absolute path instead. This is also
   why `herdr worktree create` is NOT used anywhere here: it forces pane cwd to
   ~/.herdr/worktrees/<repo>/<branch> and ignores `[terminal] new_cwd = "home"`
   (verified 2026-09-17).
2. **The caller keeps focus.** Every split is --no-focus. Background work must
   not yank the user out of what they are reading.

Usage:
  herd status [--stale MIN]        the herd: who is live, doing what, how stale
  herd run <label> -- <cmd...>     sibling pane, named, runs cmd; prints pane id
  herd gate <label> -- <cmd...>    run it, wait for it, exit with its code
  herd wait <pane> --match TEXT | --regex PAT [--timeout MS]
  herd read <target> [--lines N]   pane id or agent name
  herd spawn <name> --task "..."   child agent in its OWN TAB; fire-and-forget
  herd inbox [<name>]              what the children have reported back
  herd reviewer <name> [--kind K]  sibling pane + agent; prints agent name
  herd ask <name> <prompt> [--timeout MS]   prompt an agent, wait, print reply
  herd notify <title> [--body TEXT] [--sound done|request]
  herd tab-name <label> [--force]  name this tab after the task it is running
  herd close <pane|label|name>... | --all

  herd --machine <label> status     the same, against a saved SSH machine
                                    (herdr 0.9.1+; observe/steer verbs only)

Without --machine, requires HERDR_ENV=1 — controlling the session from outside it targets whatever
pane some other client happens to have focused.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

TRANSCRIPTS = Path.home() / ".claude" / "projects" / "-home-matt"


def die(msg, code=1):
    print(f"herd: {msg}", file=sys.stderr)
    sys.exit(code)


# Set by --machine: forward every call to a saved SSH machine's session
# (herdr 0.9.1+). Empty means "the session this pane belongs to".
MACHINE = []

# Verbs that must split a pane. They need a *caller* pane to split from and
# size against, which only exists in the session you are actually sitting in.
NEEDS_LOCAL_PANE = {"run", "gate", "reviewer"}

# Verbs that cross the filesystem, not just the socket API. `spawn` needs a pane
# cwd and a report path that exist on the machine the child runs on; `inbox`
# reads those reports back. Under --machine both silently resolve against the
# WRONG home — a MacBook's /Users/mattwagner for work happening on omarchy — so
# the brief tells the child to write somewhere the driver will never look.
# Attaching (`work`) puts you in a real pane on that machine and every verb
# works unchanged, so that is the supported answer rather than an ssh shim.
NEEDS_LOCAL_FS = {"spawn", "inbox"}

SUBCOMMANDS = ["status", "run", "wait", "gate", "read", "reviewer", "ask",
               "notify", "tab-name", "close", "spawn", "inbox"]


def require_herdr(args):
    """Local calls must come from inside a pane; remote calls name their target.

    The guard exists so a bare `herd` never drives whatever pane some other
    client happens to have focused. `--machine` removes that ambiguity by
    naming the session explicitly, so it does not need HERDR_ENV.
    """
    if MACHINE:
        if args.cmd in NEEDS_LOCAL_PANE:
            die(f"`herd {args.cmd}` splits a pane, which needs a caller pane in "
                f"the session you are in — there is none on a remote machine. "
                f"Use it from a pane on that machine, or pick an observe/steer "
                f"verb: {', '.join(sorted(set(SUBCOMMANDS) - NEEDS_LOCAL_PANE - NEEDS_LOCAL_FS))}.")
        if args.cmd in NEEDS_LOCAL_FS:
            die(f"`herd {args.cmd}` reads and writes files on the machine the "
                f"work runs on; over --machine it would resolve them against "
                f"THIS host's home instead. Attach and run it from there: "
                f"work {args.machine}")
        return
    if os.environ.get("HERDR_ENV") != "1":
        die("not running inside a Herdr pane (HERDR_ENV != 1). Either run this "
            "from a Herdr pane, or name a machine: herd --machine <label> ...")


def _run(args, check=True):
    """Run the herdr CLI. Returns (returncode, stdout, stderr)."""
    proc = subprocess.run(["herdr", *MACHINE, *args], capture_output=True, text=True)
    if proc.returncode != 0 and check:
        die(f"herdr {' '.join(args)} failed: "
            f"{proc.stderr.strip() or proc.stdout.strip() or 'no output'}")
    return proc.returncode, proc.stdout, proc.stderr


def herdr(*args, check=True):
    """For commands that answer in JSON: returns the parsed .result.

    Most control verbs do. The exceptions are `pane run` (silent on success)
    and `pane read` / `agent read`, which write raw terminal text — use
    herdr_text() for those.
    """
    rc, out, _ = _run(list(args), check=check)
    if rc != 0:
        return None
    try:
        return json.loads(out)["result"]
    except (ValueError, KeyError):
        if check:
            die(f"herdr {' '.join(args)} returned unparseable output: {out[:200]}")
        return None


def herdr_text(*args, check=True):
    """For commands that answer in plain text (or nothing at all)."""
    rc, out, _ = _run(list(args), check=check)
    return None if rc != 0 else out


# What the caller keeps when it gives up room for its FIRST background pane.
# Everything after that splits background panes, so this is the only time the
# driver's rectangle ever changes.
DRIVER_SHARE = 0.62

# Below this the driver is not readable prose any more — at 27 columns a Claude
# pane wraps mid-word and the question it is asking you is unreadable.
DRIVER_FLOOR = (72, 18)

STATE_DIR = Path.home() / ".cache" / "herd"


def state_file():
    """Panes this caller opened, so it can find them again and close them.

    Keyed by the caller's pane: two agents sharing a workspace each own their
    own background panes and must not close each other's.
    """
    return STATE_DIR / f"{os.environ.get('HERDR_PANE_ID', 'unknown')}.json"


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def load_mine():
    return read_json(state_file()) or {}


def save_mine(mine):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state_file().write_text(json.dumps(mine, indent=1, sort_keys=True))


def split_dir(rect):
    """Wide panes split right, tall/narrow panes split down.

    Terminal cells are about twice as tall as wide, so compare width against
    doubled height rather than raw rows.
    """
    return "right" if rect["width"] >= rect["height"] * 2 else "down"


def new_pane(label=None):
    """Split a sibling pane at $HOME, unfocused. Returns pane_id.

    The caller is split at most ONCE. After that every background pane is
    carved out of the largest background pane this caller already owns, so the
    layout settles into "driver on one side, a stack of work on the other"
    instead of halving the driver on every gate. Six splits off the caller is
    a 27-column agent pane nobody can read — which is exactly how a driver
    ends up asking a question in a box too small to show the question.
    """
    layout = herdr("pane", "layout", "--current")["layout"]
    rects = {p["pane_id"]: p["rect"] for p in layout["panes"]}
    # `pane layout` carries geometry only — labels live on `pane list`.
    labels = {p["pane_id"]: p.get("label")
              for p in (herdr("pane", "list", check=False) or {}).get("panes", [])}
    # Measure the CALLER's pane, not the focused one. They are the same only
    # when the user happens to be looking at us; an agent doing background work
    # is by definition not focused, and sizing the split off whatever the UI
    # has focused picks the wrong direction exactly when it matters.
    me_id = os.environ.get("HERDR_PANE_ID") or layout["focused_pane_id"]

    mine = load_mine()
    # Panes I opened that are still alive. A pane the user closed by hand, or
    # one from a previous run of this session, is gone from the layout.
    live = [pid for pid in mine if pid in rects and pid != me_id]

    if live:
        host = max(live, key=lambda pid: rects[pid]["width"] * rects[pid]["height"])
        ratio = []
    else:
        host = me_id
        ratio = ["--ratio", str(DRIVER_SHARE)]
        # Name the driver before it stops being the only pane. Work panes carry
        # labels; an unlabelled box among them reads as leftover output, which
        # is the wrong thing to think about the pane that will ask you a
        # question when it is done.
        if not labels.get(me_id):
            herdr("pane", "rename", me_id, os.environ.get("HERD_DRIVER_LABEL", "driver"),
                  check=False)
        r = rects.get(me_id)
        if r and (r["width"] * DRIVER_SHARE < DRIVER_FLOOR[0]
                  or r["height"] * DRIVER_SHARE < DRIVER_FLOOR[1]):
            print(f"herd: warning — this pane is already {r['width']}x{r['height']}; "
                  f"splitting it again leaves it unreadable. Close stale panes "
                  f"(herd close --all) or zoom this one to read it.", file=sys.stderr)

    target = ["--current"] if host == me_id else ["--pane", host]
    res = herdr("pane", "split", *target,
                "--direction", split_dir(rects.get(host, {"width": 2, "height": 1})),
                *ratio,
                "--cwd", str(Path.home()),
                "--no-focus")
    pane_id = res["pane"]["pane_id"]
    if label:
        herdr("pane", "rename", pane_id, label)

    mine[pane_id] = label or pane_id
    save_mine(mine)
    return pane_id


def resolve_pane(target):
    """pane id, pane label, or live agent name -> pane id.

    `herdr pane close` takes only a pane id, and answers a label with
    `pane_not_found` **at exit code 0**. Every other verb here is name-first,
    so a caller naturally writes `herd close rev-51` — and used to get a
    silent no-op that leaked the pane and shrank the driver.
    """
    panes = herdr("pane", "list")["panes"]
    by_id = {p["pane_id"]: p for p in panes}
    if target in by_id:
        return target
    for p in panes:
        if p.get("label") == target:
            return p["pane_id"]
    agents = (herdr("agent", "list", check=False) or {}).get("agents", [])
    for a in agents:
        if a.get("agent_name") == target or a.get("name") == target:
            return a["pane_id"]
    return None


# ---------------------------------------------------------------- subcommands

def cmd_status(args):
    agents = herdr("agent", "list")["agents"]
    spaces = {w["workspace_id"]: w["label"]
              for w in herdr("workspace", "list")["workspaces"]}
    now = time.time()

    rows = []
    for a in agents:
        sess = (a.get("agent_session") or {}).get("value")
        age = None
        if sess and a.get("agent") == "claude":
            t = TRANSCRIPTS / f"{sess}.jsonl"
            if t.exists():
                age = (now - t.stat().st_mtime) / 60.0
        rows.append({
            "space": spaces.get(a["workspace_id"], a["workspace_id"]),
            "pane": a["pane_id"],
            "kind": a.get("agent", "?"),
            "state": a.get("agent_status", "?"),
            "title": a.get("terminal_title_stripped") or "",
            "age": age,
            "focused": a.get("focused", False),
        })

    order = {"blocked": 0, "done": 1, "working": 2, "idle": 3, "unknown": 4}
    rows.sort(key=lambda r: (order.get(r["state"], 9), -(r["age"] or 0)))

    mark = {"blocked": "!", "done": "*", "working": ">", "idle": ".", "unknown": "?"}
    w = max((len(r["space"]) for r in rows), default=5)
    print(f"{len(rows)} agents / {len(spaces)} workspaces\n")
    for r in rows:
        age = f"{r['age']:6.0f}m" if r["age"] is not None else "     --"
        flag = "@" if r["focused"] else " "
        stale = "  <-- stale" if (args.stale and r["age"] and r["age"] > args.stale
                                  and r["state"] == "idle") else ""
        print(f" {mark.get(r['state'],'?')}{flag} {r['space']:<{w}}  {r['kind']:<7}"
              f" {r['state']:<8} {age}  {r['title'][:46]}{stale}")
    print("\n  ! blocked   * done (unseen)   > working   . idle   @ focused")
    if args.stale:
        print(f"  stale = idle with no transcript write in {args.stale}m "
              f"(claude panes only; cursor has no readable transcript here)")


def cmd_run(args):
    # Validate before splitting: a die() after new_pane() strands an orphan
    # pane that nothing will ever close.
    if not args.command:
        die("nothing to run; usage: herd run <label> -- <cmd...>")
    pane = new_pane(args.label)
    herdr_text("pane", "run", pane, " ".join(args.command))
    print(pane)


def cmd_wait(args):
    call = ["pane", "wait-output", args.pane]
    call += ["--regex", args.regex] if args.regex else ["--match", args.match]
    call += ["--source", "recent-unwrapped"]
    if args.timeout:
        call += ["--timeout", str(args.timeout)]
    res = herdr(*call, check=False)
    if res is None:
        die("wait timed out, pattern never appeared, or the pane is gone", 2)
    # wait-output already carries the snapshot it matched against.
    print((res.get("read") or {}).get("text", ""))


def cmd_gate(args):
    """Run a command in a sibling pane, wait for it to finish, report rc.

    Two traps this works around:

    * `pane wait-output` searches a snapshot that includes the command line
      just typed, so a plain --match on a sentinel matches the echo of the
      command itself and returns before anything ran. The guard is a marker
      whose *shape* cannot appear in the command text: the command carries a
      literal `rc=$?`, the pattern demands digits.
    * A command that calls `exit` would take the pane's shell down with it and
      the marker would never print, which is indistinguishable from a hang.
      Running it in a subshell contains that.
    """
    cmd = args.command
    if not cmd:
        die("nothing to run; usage: herd gate <label> -- <cmd...>")

    token = f"HERD_{re.sub(r'[^A-Z0-9]', '_', args.label.upper())}_{os.urandom(3).hex().upper()}"
    pane = new_pane(args.label)
    herdr_text("pane", "run", pane, f'( {" ".join(cmd)} ); echo "{token} rc=$?"')

    res = herdr("pane", "wait-output", pane,
                "--regex", rf"{token} rc=[0-9]+",
                "--source", "recent-unwrapped",
                "--lines", str(args.lines),
                "--timeout", str(args.timeout), check=False)
    if res is None:
        alive = herdr("pane", "get", pane, check=False) is not None
        why = (f"did not finish within {args.timeout}ms"
               if alive else "pane died before reporting a result")
        print(f"-- {args.label}: {why}"
              f"{' (pane ' + pane + ' left open)' if alive else ''}", file=sys.stderr)
        sys.exit(2)

    text = (res.get("read") or {}).get("text", "")

    rc = 1
    for line in reversed(text.splitlines()):
        if line.startswith(token) and "rc=" in line:
            tail = line.split("rc=", 1)[1].strip()
            if tail.isdigit():
                rc = int(tail)
            break

    # Trim shell noise. The command text echoes twice — once as the pane
    # renders it, once after the prompt — so anchor on the LAST echo that is
    # not the completion marker, and keep only what the command actually
    # printed. Trailing prompt redraws go too.
    lines = text.splitlines()
    marker = re.compile(rf"^{token} rc=[0-9]+\s*$")
    last_echo = max((i for i, l in enumerate(lines)
                     if token in l and not marker.match(l.strip())), default=-1)
    body_lines = lines[last_echo + 1:] if last_echo >= 0 else lines
    body_lines = [l for l in body_lines if token not in l]
    while body_lines and not body_lines[-1].strip().rstrip("❯$%#").strip():
        body_lines.pop()
    if body_lines and body_lines[-1].strip().rstrip("❯$%#").strip() == "~":
        body_lines.pop()
    body = "\n".join(body_lines).strip()
    if args.chars and len(body) > args.chars:
        body = "... [trimmed]\n" + body[-args.chars:]
    print(body)
    print(f"\n-- {args.label}: exit {rc} (pane {pane})", file=sys.stderr)

    if args.close and rc == 0:
        herdr("pane", "close", pane)
        mine = load_mine()
        mine.pop(pane, None)
        save_mine(mine)
    if args.notify:
        herdr("notification", "show",
              f"{args.label}: {'passed' if rc == 0 else 'FAILED'}",
              "--body", f"exit {rc}",
              "--sound", "done" if rc == 0 else "request")
    sys.exit(rc)


def cmd_read(args):
    for group in ("agent", "pane"):
        out = herdr_text(group, "read", args.target,
                         "--source", "recent-unwrapped",
                         "--lines", str(args.lines), check=False)
        if out is not None:
            print(out, end="")
            return
    die(f"could not read {args.target} as an agent name or pane id")


def cmd_reviewer(args):
    pane = new_pane(args.name)
    # A freshly split pane needs its shell at an interactive prompt before
    # `agent start` will accept it.
    time.sleep(1.5)
    herdr("agent", "start", args.name, "--kind", args.kind, "--pane", pane)
    print(args.name)


def cmd_ask(args):
    # Prompting an agent that is mid-turn queues the text as a follow-up in
    # some TUIs (cursor) rather than steering it, so the answer you read back
    # is the *previous* turn's. Settle first.
    st = herdr("agent", "get", args.name, check=False) or {}
    st = st.get("agent", st)
    if st.get("agent_status") == "working":
        herdr("agent", "wait", args.name, "--timeout", str(args.timeout), check=False)

    call = ["agent", "prompt", args.name, args.prompt, "--wait"]
    if args.timeout:
        call += ["--timeout", str(args.timeout)]
    herdr(*call)
    print(herdr_text("agent", "read", args.name,
                     "--source", "recent-unwrapped",
                     "--lines", str(args.lines)), end="")


def cmd_notify(args):
    call = ["notification", "show", args.title]
    if args.body:
        call += ["--body", args.body]
    if args.sound:
        call += ["--sound", args.sound]
    herdr(*call)


def tab_state_file(tab_id):
    """The label THIS tooling last set on a tab.

    Kept out of the pane state file on purpose: `herd close --all` walks that
    dict as a list of pane ids, so a stray key there is a pane it would try to
    close.
    """
    return STATE_DIR / f"{tab_id}.tab.json"


def cmd_tab_name(args):
    """Name the caller's tab after the work it is doing.

    A sidebar of tabs called 1, 2, 3 says nothing about which one is shipping
    which ticket, and an agent doing background work is in whichever tab Matt
    left it in. Naming is cheap; naming over something is not, so this refuses
    three cases rather than guessing:

    - the caller's pane is not actually hosting an agent, which is what a
      `claude --bg` session looks like: the work is detached and the pane went
      back to a shell prompt, so the tab is Matt's, not the run's
    - the tab holds a pane this caller did not open (someone else's work is
      sharing it — the name would describe only half the tab)
    - the tab already carries a label a human chose (anything but bare digits,
      or the label this tooling last set here)

    All three are non-fatal: the caller is doing something else and should not
    stop because a cosmetic rename did not apply.
    """
    if MACHINE:
        die("`herd tab-name` names the tab you are sitting in; there is no "
            "caller tab on a remote machine.")
    tab_id = os.environ.get("HERDR_TAB_ID")
    if not tab_id:
        die("no $HERDR_TAB_ID — not running inside a Herdr pane.")

    tab = herdr("tab", "get", tab_id)["tab"]
    current = tab.get("label") or ""
    # An unnamed tab is labelled with its POSITION in the sidebar, which is not
    # the `number` field (that is a monotonic id — tab 5 can be labelled "2").
    # So "still default" is "the label is bare digits", and a human who really
    # did name a tab "7" loses nothing worth keeping.
    default = current == "" or current.isdigit()
    ours = current == (read_json(tab_state_file(tab_id)) or {}).get("label")

    if not (default or ours or args.force):
        print(f"herd: tab {tab_id} is already named {current!r}; leaving it "
              f"(--force to rename anyway)", file=sys.stderr)
        return

    mine = load_mine()
    me_id = os.environ.get("HERDR_PANE_ID")
    panes = herdr("pane", "list")["panes"]
    me = next((p for p in panes if p["pane_id"] == me_id), None)
    if me is not None and not me.get("agent") and not args.force:
        print(f"herd: pane {me_id} is a shell, not an agent — this looks like a "
              f"detached session, and its tab is not the run's to name",
              file=sys.stderr)
        return

    strangers = [p["pane_id"] for p in panes
                 if p["tab_id"] == tab_id
                 and p["pane_id"] != me_id
                 and p["pane_id"] not in mine]
    if strangers and not args.force:
        print(f"herd: tab {tab_id} also holds {', '.join(strangers)}, which this "
              f"session did not open; leaving it {current!r} (--force to rename "
              f"anyway)", file=sys.stderr)
        return

    herdr("tab", "rename", tab_id, args.label)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tab_state_file(tab_id).write_text(json.dumps({"label": args.label}))
    print(args.label)


def cmd_close(args):
    """Close by pane id, label, or agent name — and say so when nothing matched."""
    mine = load_mine()
    spawns = load_spawns()

    # A spawned child owns a whole tab, so closing its pane would leave the tab
    # behind. Peel those off by name before anything reaches the pane path.
    if args.all:
        children, targets = list(spawns), list(mine)
        if not children and not targets:
            print("herd: nothing tracked to close", file=sys.stderr)
            return
    elif args.pane:
        children = [t for t in args.pane if t in spawns]
        targets = [t for t in args.pane if t not in spawns]
    else:
        die("nothing to close; usage: herd close <pane|label|name>... | --all")

    for name in children:
        herdr("tab", "close", spawns[name]["tab"], check=False)
        spawns.pop(name)
        print(name)
    if children:
        save_spawns(spawns)

    if not targets:
        return

    missing = []
    for t in targets:
        pane_id = resolve_pane(t)
        if pane_id is None:
            mine.pop(t, None)
            missing.append(t)
            continue
        herdr("pane", "close", pane_id)
        mine.pop(pane_id, None)
        print(pane_id)
    save_mine(mine)
    if missing:
        die(f"no pane, label, or agent named: {', '.join(missing)}", 2)


# ------------------------------------------------------------------- spawning

REPORTS = STATE_DIR / "reports"

# A spawned child cannot be read back through its TUI. Agent panes paint on the
# terminal's alternate screen, so `agent read` returns the tool-call rail plus
# "… N output lines hidden" and raising --lines recovers nothing. The only path
# from a child's findings to the driver is a file both sides agreed on before
# the work started, so every brief carries this tail.
BRIEF_TAIL = """

--- reporting back (herd) ---
Write your complete result as Markdown to {report}, then reply with only that path.
Make the first line a one-sentence headline: that line is what the driver sees.
If you need Matt to decide something before you can finish, write what you have so
far to that file, then run:

  herdr notification show "{name} needs you" --body "<your question>" --sound request

and stop. Do not leave the question only in your reply — Herdr classifies `blocked`
from an approval or question *UI*, so a turn that ends on prose asking something
looks exactly like a turn that finished. The notification is the only signal that
crosses.
"""

# The dialog a freshly spawned `claude` opens on, and the option to land on.
# Matched on the option text rather than the prose above it, which changes.
TRUST_OPTION = "Yes, I trust this folder"


def spawn_state_file():
    """Children this caller dispatched. Kept out of the pane state file because
    `herd close --all` walks that dict as a flat list of pane ids — a tab id in
    there is something it would hand to `pane close`."""
    return STATE_DIR / f"{os.environ.get('HERDR_PANE_ID', 'unknown')}.spawns.json"


def load_spawns():
    return read_json(spawn_state_file()) or {}


def save_spawns(spawns):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    spawn_state_file().write_text(json.dumps(spawns, indent=1, sort_keys=True))


def agent_state(name):
    agents = (herdr("agent", "list", check=False) or {}).get("agents", [])
    for a in agents:
        if (a.get("agent_name") or a.get("name")) == name:
            return a
    return None


def clear_trust_dialog(name):
    """Answer the one startup dialog we recognise, and only that one.

    A `claude` started in a brand-new pane opens on the trust-this-folder
    prompt: `agent start` returns `agent_not_ready`, Herdr reports `blocked`,
    and an unattended spawn parks there forever looking like a hung launch.
    Every *other* blocked UI is Matt's to read before anything types into it,
    so this matches the option text and refuses to guess at anything else.
    """
    screen = herdr_text("agent", "read", name, "--source", "detection",
                        "--lines", "40", check=False) or ""
    if TRUST_OPTION not in screen:
        return False
    # The dialog opens on "No, exit"; the trust option is one below it.
    herdr("agent", "send-keys", name, "down", check=False)
    herdr("agent", "send-keys", name, "enter", check=False)
    herdr("agent", "wait", name, "--timeout", "30000", check=False)
    return True


def cmd_spawn(args):
    if not args.task:
        die('nothing to dispatch; usage: herd spawn <name> --task "<brief>"')
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", args.name):
        die(f"{args.name!r} is not a legal agent name: [a-z][a-z0-9_-]{{0,31}}")
    if agent_state(args.name):
        die(f"an agent named {args.name!r} is already live; pick another name "
            f"or close it (herd close {args.name})")

    REPORTS.mkdir(parents=True, exist_ok=True)
    report = REPORTS / f"{args.name}.md"
    # A stale report from a previous run of the same name would read as this
    # run's answer the moment `herd inbox` looked.
    if report.exists():
        report.unlink()

    ws = args.workspace or os.environ.get("HERDR_WORKSPACE_ID")
    if not ws:
        die("no workspace to spawn into; pass --workspace or run from a pane")

    # A TAB, not a split. `pane split` carves the new pane out of the caller,
    # so a driver that dispatches six children is 1/2^6 of the rectangle it
    # started in — which is how a driver ends up asking a question in a box too
    # narrow to show the question. A tab leaves the driver untouched and gives
    # the child a full-size pane to work in.
    res = herdr("tab", "create", "--workspace", ws,
                "--cwd", str(Path.home()),
                "--label", args.label or args.name,
                "--no-focus")
    tab_id = res["tab"]["tab_id"]
    pane_id = res["root_pane"]["pane_id"]

    # A freshly created pane needs its shell at an interactive prompt before
    # `agent start` will accept it.
    time.sleep(1.5)
    started = herdr("agent", "start", args.name, "--kind", args.kind,
                    "--pane", pane_id, *(["--", *args.command] if args.command else []),
                    check=False)
    if started is None and not clear_trust_dialog(args.name):
        # Left OPEN on purpose: an unrecognised blocked UI is the one case
        # where the pane is the evidence. Everything else below tears down.
        die(f"{args.name} is blocked at startup and it is not the trust dialog — "
            f"read it before answering, then close it: herd read {args.name} "
            f"(pane {pane_id}, tab {tab_id})", 2)

    st = agent_state(args.name) or {}
    if st.get("agent_status") != "idle":
        herdr("agent", "wait", args.name, "--timeout", str(args.timeout), check=False)

    brief = args.task + BRIEF_TAIL.format(report=report, name=args.name)
    # Deliberately NOT --wait. The whole point of a driver is that it stays
    # available for the next thing Matt says; a driver blocked on a ten-minute
    # child is strictly worse than the tab he would have opened by hand.
    #
    # Retried because a just-started agent lies about being ready: Herdr reports
    # `idle` with interactive_ready=true while the TUI is still painting, the
    # paste goes nowhere, and `agent prompt` burns its five-second
    # lifecycle-change budget and returns agent_prompt_stalled. Measured on this
    # host: the first attempt after the trust dialog fails, the second lands.
    for attempt in range(3):
        if herdr("agent", "prompt", args.name, brief, check=False) is not None:
            break
        time.sleep(3)
    else:
        herdr("tab", "close", tab_id, check=False)
        die(f"{args.name} would not take the brief after 3 tries; tab {tab_id} "
            f"closed. Retry, or start it by hand to watch it: "
            f"herdr tab create --workspace {ws} --cwd ~ --no-focus", 2)

    spawns = load_spawns()
    spawns[args.name] = {
        "tab": tab_id,
        "pane": pane_id,
        "kind": args.kind,
        "report": str(report),
        "task": args.task[:200],
        "spawned_at": time.time(),
        "seen_at": 0,
    }
    save_spawns(spawns)

    print(f"{args.name}  tab {tab_id}  pane {pane_id}")
    print(f"report: {report}", file=sys.stderr)


def headline(path):
    """The one line of a report worth putting in a list.

    The brief asks for a one-sentence headline on line one, and children
    routinely open with `# Title` instead — observed on the first two-child run.
    A title restates the task the driver already knows, so prefer the first
    line of actual prose and fall back to the heading only if there is none.
    """
    try:
        lines = [l.strip() for l in Path(path).read_text().splitlines()]
    except OSError:
        return ""
    prose = next((l for l in lines if l and not l.startswith(("#", "```", "-", "*", "|"))), "")
    if prose:
        return prose
    return next((l.lstrip("#").strip() for l in lines if l.strip("# ")), "")


def cmd_inbox(args):
    spawns = load_spawns()
    if not spawns:
        print("herd: nothing dispatched from this pane", file=sys.stderr)
        return

    if args.name:
        if args.name not in spawns:
            die(f"{args.name!r} was not dispatched from this pane; "
                f"known: {', '.join(sorted(spawns)) or 'none'}", 2)
        path = Path(spawns[args.name]["report"])
        if not path.exists():
            die(f"{args.name} has not written {path} yet", 2)
        print(path.read_text(), end="")
        spawns[args.name]["seen_at"] = time.time()
        save_spawns(spawns)
        return

    now = time.time()
    rows, gone = [], []
    for name, s in sorted(spawns.items()):
        st = agent_state(name)
        path = Path(s["report"])
        mtime = path.stat().st_mtime if path.exists() else 0
        if st is None and not mtime:
            gone.append(name)
            continue
        rows.append({
            "name": name,
            # An agent that exited but left a report is still useful; one that
            # left neither is the row above, pruned.
            "state": (st or {}).get("agent_status", "exited"),
            "new": bool(mtime and mtime > s.get("seen_at", 0)),
            "age": (now - mtime) / 60.0 if mtime else None,
            "line": headline(path) if mtime else s.get("task", ""),
            "reported": bool(mtime),
        })

    for name in gone:
        spawns.pop(name)
    if gone:
        save_spawns(spawns)

    if not rows:
        print("herd: nothing dispatched from this pane", file=sys.stderr)
        return

    w = max(len(r["name"]) for r in rows)
    order = {"blocked": 0, "done": 1, "working": 2, "idle": 3}
    rows.sort(key=lambda r: (not r["new"], order.get(r["state"], 9)))
    for r in rows:
        mark = "*" if r["new"] else (" " if r["reported"] else "-")
        age = f"{r['age']:5.0f}m" if r["age"] is not None else "    --"
        print(f" {mark} {r['name']:<{w}}  {r['state']:<8} {age}  {r['line'][:64]}")
    print("\n  * unread report   (blank) read   - no report yet")
    print(f"  herd inbox <name> to read one in full; reports in {REPORTS}")


def split_command(argv):
    """Peel `-- <cmd...>` off the end so argparse never sees the command.

    argparse.REMAINDER swallows any flag that follows the first positional,
    which silently turns `herd gate x --close -- npm test` into a command of
    "--close -- npm test". Splitting by hand keeps flags on either side.
    """
    if "--" not in argv:
        return argv, []
    i = argv.index("--")
    return argv[:i], argv[i + 1:]


def main():
    p = argparse.ArgumentParser(prog="herd", add_help=True,
                                description="drive a Herdr session")
    p.add_argument("--machine", metavar="LABEL",
                   help="run against a saved SSH machine's session instead of "
                        "this one (herdr machine list). Observe/steer verbs "
                        "only — splitting a pane needs a local caller pane.")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status"); s.add_argument("--stale", type=int, default=120)
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("run"); s.add_argument("label")
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("wait"); s.add_argument("pane")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--match"); g.add_argument("--regex")
    s.add_argument("--timeout", type=int, default=600000)
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("gate"); s.add_argument("label")
    s.add_argument("--timeout", type=int, default=900000)
    s.add_argument("--lines", type=int, default=400)
    s.add_argument("--chars", type=int, default=4000,
                   help="trim the reported tail to this many characters (0 = all)")
    s.add_argument("--close", action="store_true", help="close the pane if it passed")
    s.add_argument("--notify", action="store_true", help="raise a toast with the result")
    s.set_defaults(fn=cmd_gate)

    s = sub.add_parser("read"); s.add_argument("target")
    s.add_argument("--lines", type=int, default=200)
    s.set_defaults(fn=cmd_read)

    s = sub.add_parser("reviewer"); s.add_argument("name")
    # cursor, not codex: codex is not signed in on this host and Matt does not
    # use it, so a codex default silently parks the reviewer at a login prompt
    # that Herdr reports as `idle`.
    s.add_argument("--kind", default="cursor")
    s.set_defaults(fn=cmd_reviewer)

    s = sub.add_parser("ask"); s.add_argument("name"); s.add_argument("prompt")
    s.add_argument("--timeout", type=int, default=600000)
    s.add_argument("--lines", type=int, default=300)
    s.set_defaults(fn=cmd_ask)

    s = sub.add_parser("notify"); s.add_argument("title")
    s.add_argument("--body"); s.add_argument("--sound", choices=["none", "done", "request"])
    s.set_defaults(fn=cmd_notify)

    s = sub.add_parser("tab-name"); s.add_argument("label")
    s.add_argument("--force", action="store_true",
                   help="rename even if the tab is named or shared")
    s.set_defaults(fn=cmd_tab_name)

    s = sub.add_parser("spawn"); s.add_argument("name")
    s.add_argument("--task", required=True, help="the brief to dispatch")
    s.add_argument("--kind", default="claude")
    s.add_argument("--label", help="tab label (default: the agent name)")
    s.add_argument("--workspace", help="spawn into this workspace "
                                       "(default: the caller's)")
    s.add_argument("--timeout", type=int, default=60000,
                   help="how long to wait for the child to reach idle before "
                        "handing it the brief")
    s.set_defaults(fn=cmd_spawn)

    s = sub.add_parser("inbox"); s.add_argument("name", nargs="?")
    s.set_defaults(fn=cmd_inbox)

    s = sub.add_parser("close"); s.add_argument("pane", nargs="*")
    s.add_argument("--all", action="store_true",
                   help="close every background pane and spawned child "
                        "this caller opened")
    s.set_defaults(fn=cmd_close)

    flags, command = split_command(sys.argv[1:])
    args = p.parse_args(flags)
    args.command = command
    if args.machine:
        MACHINE[:] = ["--machine", args.machine]
    require_herdr(args)
    args.fn(args)


if __name__ == "__main__":
    main()
