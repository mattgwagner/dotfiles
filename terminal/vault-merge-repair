#!/usr/bin/env bash
# vault-merge-repair: resolve a vault-backup merge conflict without a human.
#
# Called by vault-backup.sh after `git merge origin/main` conflicted and was aborted.
# The live tree is kept converged by Obsidian Sync, so for each conflicted file the
# live copy is normally the right answer. This proves it before trusting it: every
# line either side added since the merge base must already be in the live file, and
# the live file must hold no conflict markers. Any doubt -> exit 1 and the caller pages.
#
# The merge runs in a throwaway worktree, so conflict markers never land in the
# Obsidian-synced tree (they would sync to every device). The live checkout then
# fast-forwards to the merge commit. History is only ever added to: no reset, no
# force-push, origin stays reachable.
#
# Usage: vault-merge-repair            (repo: $VAULT_REPO or ~/vault, branch main)
# Prints what it did; exit 0 = merged, 1 = refused (reason on stdout).
set -u
REPO="${VAULT_REPO:-$HOME/vault}"
BRANCH=main
cd "$REPO" || { echo "no repo at $REPO"; exit 1; }
[ -f .git/MERGE_HEAD ] && { echo "a merge is in progress in the live tree"; exit 1; }

mkdir -p "$HOME/.cache"
W=$(mktemp -d "$HOME/.cache/vault-merge-repair.XXXXXX")   # not /tmp: tmpfs, and quota'd
cleanup() {
  git -C "$REPO" worktree remove --force "$W" >/dev/null 2>&1
  rm -rf "$W"; git -C "$REPO" worktree prune 2>/dev/null
}
trap cleanup EXIT
rmdir "$W"
git worktree add -q --detach "$W" HEAD 2>/dev/null || { echo "worktree add failed"; exit 1; }
cd "$W"

msg="Merge origin/$BRANCH (vault-merge-repair on $(hostname))"
if git merge --no-ff -q -m "$msg" "origin/$BRANCH" >/dev/null 2>&1; then
  fixed="none (merged clean)"
else
  base=$(git merge-base HEAD MERGE_HEAD)
  fixed=""
  while IFS= read -r -d '' f; do
    live="$REPO/$f"
    [ -f "$live" ] || { echo "refused: $f is deleted on one side (live copy missing)"; exit 1; }
    grep -qE '^(<<<<<<<|>>>>>>>) ' "$live" && { echo "refused: live $f has conflict markers"; exit 1; }
    for side in HEAD MERGE_HEAD; do
      while IFS= read -r line; do
        [ -z "${line//[[:space:]]/}" ] && continue
        grep -qxF -- "$line" "$live" || {
          echo "refused: live $f lacks a line $side added: ${line:0:120}"; exit 1; }
      done < <(git diff "$base" "$side" -- "$f" | sed -n 's/^+\([^+]\)/\1/p; s/^+$//p')
    done
    cp -- "$live" "$f" && git add -- "$f" || { echo "refused: could not stage $f"; exit 1; }
    fixed+="${fixed:+, }$f"
  done < <(git diff -z --name-only --diff-filter=U)
  [ -z "$(git diff --name-only --diff-filter=U)" ] || { echo "refused: unmerged paths remain"; exit 1; }
  git commit -q --no-edit >/dev/null 2>&1 || { echo "refused: merge commit failed"; exit 1; }
fi

M=$(git rev-parse HEAD)
cd "$REPO"
git merge --ff-only -q "$M" 2>/dev/null || { echo "refused: live tree moved, fast-forward failed"; exit 1; }
echo "merged $(git rev-parse --short HEAD); took live copy of: $fixed"
